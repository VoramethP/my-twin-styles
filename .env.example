# คัดลอกเป็น .env แล้วใส่ค่าจริง — ไฟล์นี้ต้องเป็น placeholder เท่านั้น (tests/repo-hygiene.test.ts ตรวจอยู่)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
NUXT_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:yyyyyyyy@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# secret key: ใช้ได้ที่ server/utils/privileged.ts ที่เดียว (ADR-0005)
